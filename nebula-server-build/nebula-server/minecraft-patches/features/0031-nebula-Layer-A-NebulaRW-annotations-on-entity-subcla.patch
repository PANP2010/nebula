Subject: [PATCH] nebula: Layer A @NebulaRW annotations on entity subclasses
 (E1b)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ServerPlayer.doTick, ItemEntity.tick, ExperienceOrb.tick,
AbstractArrow.tick — the per-tick entry points for the four largest
non-mob entity populations on a typical server. ServerPlayer is
SERIALIZED (player list / network side effects); the rest are AUTO
because they may damage other entities or merge with neighbours.

diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 5d4310dab55cc960ccfce279e656e7b740f3d5c0..bf36d1285bcfe63edf3484500871fb357c75584d 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -988,6 +988,22 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         }
     }
 
+    @org.nebula.annotations.NebulaRW(
+        readEntities       = {"this.*", "*"},
+        writeEntities      = {"this.*"},
+        readBlocks         = {"*"},
+        readBlockEntities  = {"*.*"},
+        writeBlockEntities = {},
+        readGlobals        = {"WORLD_TIME", "GAME_RULES"},
+        writeGlobals       = {"PLAYER_LIST"},
+        triggeredEvents    = {"PLAYER_DAMAGED", "PLAYER_DEATH", "PLAYER_TELEPORT", "STATISTIC_UPDATE"},
+        microStep          = org.nebula.annotations.MicroStepBehavior.NONE,
+        scc                = org.nebula.annotations.SccBehavior.SERIALIZED,
+        maxRandomCalls     = 16,
+        randomInstance     = "ENTITY_RANDOM",
+        mayLoadChunks      = true,
+        verifiedAt         = "1.21.4"
+    )
     public void doTick() {
         try {
