--- a/net/minecraft/server/commands/NebulaCommand.java
+++ b/net/minecraft/server/commands/NebulaCommand.java
@@ -63,6 +63,8 @@ public final class NebulaCommand {
                     .executes(c -> plugins(c.getSource())))
                 .then(Commands.literal("replay")
                     .executes(c -> replay(c.getSource())))
+                .then(Commands.literal("dag")
+                    .executes(c -> dag(c.getSource())))
