                     .then(Commands.argument("count", IntegerArgumentType.integer(1, 5000))
@@ -256,6 +258,16 @@ public final class NebulaCommand {
         return io.papermc.paper.threadedregions.NebulaReplayIntegration.enabled() ? 1 : 0;
     }
 
+    /**
+     * §12.3 / §15.3 — /nebula dag renders the last-captured DAG snapshot
+     * (only populated when {@code nebula.debug.dag-visualization} is on).
+     */
+    private static int dag(final CommandSourceStack source) {
+        String body = io.papermc.paper.threadedregions.NebulaDagSnapshot.render();
+        source.sendSuccess(() -> Component.literal(body), false);
+        return io.papermc.paper.threadedregions.NebulaDagSnapshot.enabled() ? 1 : 0;
+    }
+
     private static int reset(final CommandSourceStack source) {
         NebulaTickMetrics.reset();
         NebulaRandomGate.reset();
