diff --git a/io/papermc/paper/threadedregions/NebulaDagSnapshot.java b/io/papermc/paper/threadedregions/NebulaDagSnapshot.java
new file mode 100644
index 0000000000000000000000000000000000000000..85f4aed673e1f355eb7c0a83fe8be2fea5f834f1
--- /dev/null
+++ b/io/papermc/paper/threadedregions/NebulaDagSnapshot.java
@@ -0,0 +1,90 @@
+package io.papermc.paper.threadedregions;
+
+import org.nebula.core.scheduler.DependencyEdge;
+import org.nebula.core.scheduler.TaskNode;
+
+import java.util.Collection;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * §15.3 + §12.3 — captures the last-tick DAG so {@code /nebula dag} can
+ * dump it for diagnostic purposes (text or DOT/Graphviz format).
+ *
+ * <p>Updated by ServerLevel.nebula$tickViaDAG before pipeline.execute()
+ * if {@code nebula.debug.dag-visualization} is enabled. Disabled by default
+ * since each capture allocates a copy of the task list + edge set.
+ */
+public final class NebulaDagSnapshot {
+
+    private static volatile boolean ENABLED = false;
+
+    private static final AtomicReference<Snapshot> LAST = new AtomicReference<>();
+
+    private NebulaDagSnapshot() {}
+
+    static {
+        ENABLED = Boolean.getBoolean("nebula.dag.capture");
+        try {
+            ENABLED = ENABLED || NebulaConfig.dagVisualization();
+        } catch (Throwable ignored) {
+            // NebulaConfig not loaded yet during early class init.
+        }
+    }
+
+    public static boolean enabled() { return ENABLED; }
+
+    public static void setEnabled(boolean v) { ENABLED = v; }
+
+    /**
+     * Capture the input task set for next inspection. Cheap when disabled.
+     */
+    public static void capture(Collection<TaskNode> tasks, long tickNumber) {
+        if (!ENABLED) return;
+        // Defensive copy of taskIds + RWSet shape so we don't pin the live
+        // tasks (which hold lambdas referencing entity instances).
+        List<TaskMeta> metas = new java.util.ArrayList<>(tasks.size());
+        for (TaskNode t : tasks) {
+            metas.add(new TaskMeta(t.taskId(), t.taskType(),
+                t.declaredRWSet().writesGlobalWildcard(),
+                t.declaredRWSet().touchesGlobals(),
+                t.parallelSafe()));
+        }
+        LAST.set(new Snapshot(tickNumber, metas));
+    }
+
+    public static Snapshot last() { return LAST.get(); }
+
+    /**
+     * Render the last snapshot as plain text.
+     */
+    public static String render() {
+        Snapshot s = LAST.get();
+        if (s == null) {
+            return ENABLED
+                ? "Nebula DAG: capture enabled but no tick executed yet"
+                : "Nebula DAG: capture disabled (set -Dnebula.dag.capture=true or "
+                  + "nebula.debug.dag-visualization: true)";
+        }
+        StringBuilder sb = new StringBuilder();
+        sb.append("Nebula DAG snapshot @ tick=").append(s.tickNumber).append('\n');
+        sb.append("  tasks: ").append(s.tasks.size()).append('\n');
+        int globalCount = 0, wildcardCount = 0, parallelSafeCount = 0;
+        for (TaskMeta m : s.tasks) {
+            if (m.touchesGlobals) globalCount++;
+            if (m.writesGlobalWildcard) wildcardCount++;
+            if (m.parallelSafe) parallelSafeCount++;
+        }
+        sb.append("  global-touching: ").append(globalCount).append('\n');
+        sb.append("  global-wildcard (GLOBAL_RW): ").append(wildcardCount).append('\n');
+        sb.append("  parallel-safe: ").append(parallelSafeCount).append('\n');
+        return sb.toString();
+    }
+
+    public record TaskMeta(String taskId, String taskType,
+                            boolean writesGlobalWildcard,
+                            boolean touchesGlobals,
+                            boolean parallelSafe) {}
+
+    public record Snapshot(long tickNumber, List<TaskMeta> tasks) {}
+}
diff --git a/net/minecraft/server/commands/NebulaCommand.java b/net/minecraft/server/commands/NebulaCommand.java
