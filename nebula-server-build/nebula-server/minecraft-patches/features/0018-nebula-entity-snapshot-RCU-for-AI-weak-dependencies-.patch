@@ -3213,6 +3213,11 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         // Flush pending block entities before DAG builds per-BE tasks
         worldData.pushPendingTickingBlockEntities();
 
+        // Publish entity snapshot for AI sense queries (architecture §7.4 RCU)
+        java.util.ArrayList<net.minecraft.world.entity.Entity> snapshotSource = new java.util.ArrayList<>();
+        worldData.forEachTickingEntity(snapshotSource::add);
+        io.papermc.paper.threadedregions.NebulaSnapshotRegistry.publish(this, tick, snapshotSource);
+
         // DAG-decomposed subsystems
         java.util.List<org.nebula.core.scheduler.TaskNode> tasks;
         if (this.emptyTime < 300) {
