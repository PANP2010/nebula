From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PANP2010 <18610364979@163.com>
Date: Tue, 26 May 2026 23:05:35 +0800
Subject: [PATCH] nebula: add /nebula stress-mode + decomposition counters for
 empty-world bench

- NebulaStressMode: AtomicBoolean flag toggled via /nebula stress-mode on|off,
  read by ServerLevel.nebula\$tickViaDAG to bypass emptyTime>=300 gating so
  the full DAG decomposer runs without a player in chunk-tracking range.

- NebulaTickMetrics: track decompose-full vs decompose-minimal call counts
  plus total entity-tasks and BE-tasks emitted per tick. Surfaced in summary
  string for /nebula stats.

- NebulaCommand: register stress-mode subcommand (status/on/off) plus
  stress-spawn count integration; stats line now reports the four new
  decomposition counters so empty-world bench runs can confirm whether
  full-decompose path actually executed.

diff --git a/io/papermc/paper/threadedregions/NebulaTickMetrics.java b/io/papermc/paper/threadedregions/NebulaTickMetrics.java
index e70080c03e9a67541b78c708b2eae7f3fdbe28fa..b8351c57922724a2aa9193a2ddc49f4cbaf951f0 100644
--- a/io/papermc/paper/threadedregions/NebulaTickMetrics.java
+++ b/io/papermc/paper/threadedregions/NebulaTickMetrics.java
@@ -19,6 +19,10 @@ public final class NebulaTickMetrics {
     private static final LongAdder TOTAL_LAYERS = new LongAdder();
     private static final LongAdder TOTAL_MICROSTEPS = new LongAdder();
     private static final LongAdder TOTAL_NS = new LongAdder();
+    private static final LongAdder DECOMPOSE_FULL_CALLS = new LongAdder();
+    private static final LongAdder DECOMPOSE_MINIMAL_CALLS = new LongAdder();
+    private static final LongAdder ENTITY_TASKS_TOTAL = new LongAdder();
+    private static final LongAdder BE_TASKS_TOTAL = new LongAdder();
     private static final AtomicLong PEAK_TASKS_PER_TICK = new AtomicLong();
     private static final AtomicLong PEAK_LAYERS_PER_TICK = new AtomicLong();
     private static final AtomicLong PEAK_NS_PER_TICK = new AtomicLong();
@@ -49,12 +53,26 @@ public final class NebulaTickMetrics {
         } while (!target.compareAndSet(prev, candidate));
     }
 
+    public static void recordDecomposition(boolean full, int entityTasks, int beTasks) {
+        if (full) {
+            DECOMPOSE_FULL_CALLS.increment();
+        } else {
+            DECOMPOSE_MINIMAL_CALLS.increment();
+        }
+        ENTITY_TASKS_TOTAL.add(entityTasks);
+        BE_TASKS_TOTAL.add(beTasks);
+    }
+
     public static void reset() {
         TOTAL_TICKS.reset();
         TOTAL_TASKS.reset();
         TOTAL_LAYERS.reset();
         TOTAL_MICROSTEPS.reset();
         TOTAL_NS.reset();
+        DECOMPOSE_FULL_CALLS.reset();
+        DECOMPOSE_MINIMAL_CALLS.reset();
+        ENTITY_TASKS_TOTAL.reset();
+        BE_TASKS_TOTAL.reset();
         PEAK_TASKS_PER_TICK.set(0);
         PEAK_LAYERS_PER_TICK.set(0);
         PEAK_NS_PER_TICK.set(0);
@@ -90,13 +108,19 @@ public final class NebulaTickMetrics {
     }
 
     public static String summary() {
+        long fullCalls = DECOMPOSE_FULL_CALLS.sum();
+        long minCalls = DECOMPOSE_MINIMAL_CALLS.sum();
+        long entTasks = ENTITY_TASKS_TOTAL.sum();
+        long beTasks = BE_TASKS_TOTAL.sum();
         return String.format(
             "Nebula DAG metrics: ticks=%d, avg-tasks/tick=%.1f, avg-layers/tick=%.2f, "
                 + "avg-parallelism=%.2f, avg-ms/tick=%.3f, peak-tasks=%d, peak-layers=%d, "
-                + "peak-ms=%.3f, total-microsteps=%d",
+                + "peak-ms=%.3f, total-microsteps=%d, decompose-full=%d, decompose-minimal=%d, "
+                + "entity-tasks=%d, be-tasks=%d",
             totalTicks(), avgTasksPerTick(), avgLayersPerTick(), avgParallelismPerTick(),
             avgMsPerTick(), peakTasksPerTick(), peakLayersPerTick(),
-            peakNsPerTick() / 1_000_000.0, totalMicrosteps()
+            peakNsPerTick() / 1_000_000.0, totalMicrosteps(),
+            fullCalls, minCalls, entTasks, beTasks
         );
     }
 }
diff --git a/net/minecraft/server/commands/NebulaCommand.java b/net/minecraft/server/commands/NebulaCommand.java
index 5f4f3a91c23b8c06f46864d3e6687e12d7b5a579..d43aa7805f38d4784df2e69b10ecc47a32d6817f 100644
--- a/net/minecraft/server/commands/NebulaCommand.java
+++ b/net/minecraft/server/commands/NebulaCommand.java
@@ -1,16 +1,26 @@
 package net.minecraft.server.commands;
 
 import com.mojang.brigadier.CommandDispatcher;
+import com.mojang.brigadier.arguments.IntegerArgumentType;
 import io.papermc.paper.threadedregions.NebulaExplosionPipeline;
 import io.papermc.paper.threadedregions.NebulaGuardIntegration;
 import io.papermc.paper.threadedregions.NebulaParallelIntegration;
