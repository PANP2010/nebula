@@ -109,4 +126,75 @@ public final class NebulaCommand {
         source.sendSuccess(() -> Component.literal("Nebula DAG metrics + random budget + guard + parallel counters reset."), true);
         return 1;
     }
+
+    /**
+     * Spawn N test mobs at the source position, scheduled onto the correct
+     * region thread for each chunk. Designed for benchmarking the per-entity
+     * DAG decomposition under controlled load — does not require a real
+     * player or external bot.
+     *
+     * <p>Even split across {zombie, skeleton, cow, chicken, pig}; each entity
+     * is jittered up to ±32 blocks horizontally from the source position.
+     */
+    private static int stressSpawn(final CommandSourceStack source, final int count) {
+        final ServerLevel level = source.getLevel();
+        final Vec3 origin = source.getPosition();
+        final java.util.concurrent.atomic.AtomicInteger spawned = new java.util.concurrent.atomic.AtomicInteger();
+        final java.util.concurrent.atomic.AtomicInteger failed = new java.util.concurrent.atomic.AtomicInteger();
+        final EntityType<?>[] palette = new EntityType<?>[] {
+            EntityType.ZOMBIE, EntityType.SKELETON, EntityType.COW, EntityType.CHICKEN, EntityType.PIG
+        };
+        final java.util.Random rng = new java.util.Random(42);
+
+        for (int i = 0; i < count; i++) {
+            final EntityType<?> type = palette[i % palette.length];
+            final double dx = (rng.nextDouble() - 0.5) * 64.0;
+            final double dz = (rng.nextDouble() - 0.5) * 64.0;
+            final BlockPos pos = BlockPos.containing(origin.x + dx, origin.y, origin.z + dz);
+            final int cx = pos.getX() >> 4;
+            final int cz = pos.getZ() >> 4;
+
+            RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(level, cx, cz, () -> {
+                Entity entity = type.create(level, EntitySpawnReason.COMMAND);
+                if (entity == null) {
+                    failed.incrementAndGet();
+                    return;
+                }
+                entity.snapTo(pos.getX() + 0.5, pos.getY(), pos.getZ() + 0.5, 0.0F, 0.0F);
+                if (entity instanceof Mob mob) {
+                    mob.finalizeSpawn(level, level.getCurrentDifficultyAt(pos), EntitySpawnReason.COMMAND, null);
+                }
+                if (level.tryAddFreshEntityWithPassengers(entity, org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.COMMAND)) {
+                    spawned.incrementAndGet();
+                } else {
+                    failed.incrementAndGet();
+                }
+            });
+        }
+
+        source.sendSuccess(
+            () -> Component.literal("Nebula stress-spawn: queued " + count + " entity tasks across regions"),
+            true
+        );
+        return count;
+    }
+
+    private static int stressModeStatus(final CommandSourceStack source) {
+        boolean on = NebulaStressMode.isEnabled();
+        source.sendSuccess(
+            () -> Component.literal("Nebula stress-mode: " + (on ? "ON (forces full DAG decompose, ignoring emptyTime)" : "OFF (default)")),
+            false
+        );
+        return on ? 1 : 0;
+    }
+
+    private static int stressModeSet(final CommandSourceStack source, final boolean enabled) {
+        NebulaStressMode.setEnabled(enabled);
+        source.sendSuccess(
+            () -> Component.literal("Nebula stress-mode " + (enabled ? "ENABLED" : "DISABLED")
+                + (enabled ? " — DAG decomposer will run full path even without players" : "")),
+            true
+        );
+        return enabled ? 1 : 0;
+    }
 }
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index d590642e5b4f6198ec9654ca3dd068f91c5a2903..a5ea6e68faf29a3ea1ddef512ac4d49526e25b53 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -3238,10 +3238,23 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
 
         // DAG-decomposed subsystems
         java.util.List<org.nebula.core.scheduler.TaskNode> tasks;
-        if (this.emptyTime < 300) {
-            tasks = io.papermc.paper.threadedregions.RegionTickDecomposer.decompose(this, worldData, tick, runsNormally);
+        boolean forceFull = io.papermc.paper.threadedregions.NebulaStressMode.isEnabled();
+        boolean fullDecompose = forceFull || this.emptyTime < 300;
+        if (fullDecompose) {
+            tasks = io.papermc.paper.threadedregions.RegionTickDecomposer.decomposeMinimal(this, worldData, tick, runsNormally);
+            int minimalSize = tasks.size();
+            tasks.addAll(io.papermc.paper.threadedregions.EntityTaskBuilder.buildAll(this, worldData));
+            int entityCount = tasks.size() - minimalSize;
+            int beCount = 0;
+            if (this.paperConfig().unsupportedSettings.ticking.blockEntities) {
+                int beforeBE = tasks.size();
+                tasks.addAll(io.papermc.paper.threadedregions.BlockEntityTaskBuilder.buildAll(this, worldData));
+                beCount = tasks.size() - beforeBE;
+            }
+            io.papermc.paper.threadedregions.NebulaTickMetrics.recordDecomposition(true, entityCount, beCount);
         } else {
             tasks = io.papermc.paper.threadedregions.RegionTickDecomposer.decomposeMinimal(this, worldData, tick, runsNormally);
+            io.papermc.paper.threadedregions.NebulaTickMetrics.recordDecomposition(false, 0, 0);
         }
 
         org.nebula.core.scheduler.TaskGenerator microStepGenerator =
