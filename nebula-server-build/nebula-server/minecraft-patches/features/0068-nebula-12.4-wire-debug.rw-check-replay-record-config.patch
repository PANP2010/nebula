diff --git a/io/papermc/paper/threadedregions/NebulaReplayIntegration.java b/io/papermc/paper/threadedregions/NebulaReplayIntegration.java
new file mode 100644
index 0000000000000000000000000000000000000000..c4ef65745cd932943fe30a3a87cac6baee1ccb9a
--- /dev/null
+++ b/io/papermc/paper/threadedregions/NebulaReplayIntegration.java
@@ -0,0 +1,106 @@
+package io.papermc.paper.threadedregions;
+
+import net.minecraft.server.level.ServerLevel;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * §12.4 replay record bridge — when {@code nebula.debug.replay-record: true}
+ * (or {@code -Dnebula.replay.record=true}) is set, this integration records
+ * per-tick state-hash digests via {@link NebulaServerReplayScheduler#computeStateHash(boolean)}
+ * and writes them to logs/nebula-replay.log.
+ *
+ * <p>The recorder is region-thread-safe: each tick captures the structural
+ * hash of its own ServerLevel and appends a (tick, dimension, sha) line.
+ * This is the minimum useful "replay capture" — full packet recording is
+ * a separate workstream, but a hash trail across N ticks lets divergence
+ * be located after-the-fact.
+ *
+ * <p>Activation chain:
+ * <ol>
+ *   <li>{@code -Dnebula.replay.record=true} — system property</li>
+ *   <li>{@code nebula.debug.replay-record: true} — yaml config</li>
+ * </ol>
+ */
+public final class NebulaReplayIntegration {
+
+    private static final boolean ENABLED;
+    private static final AtomicLong RECORDED_TICKS = new AtomicLong();
+    private static final java.io.PrintWriter WRITER;
+
+    static {
+        boolean fromSysProp = Boolean.getBoolean("nebula.replay.record");
+        boolean fromDebugFlag = false;
+        try {
+            fromDebugFlag = NebulaConfig.debugReplayRecord();
+        } catch (Throwable ignored) {
+            // NebulaConfig may not be loaded yet during early class init.
+        }
+        ENABLED = fromSysProp || fromDebugFlag;
+        java.io.PrintWriter w = null;
+        if (ENABLED) {
+            try {
+                java.nio.file.Path dir = java.nio.file.Paths.get("logs");
+                java.nio.file.Files.createDirectories(dir);
+                java.nio.file.Path logFile = dir.resolve("nebula-replay.log");
+                w = new java.io.PrintWriter(
+                    java.nio.file.Files.newBufferedWriter(
+                        logFile,
+                        java.nio.charset.StandardCharsets.UTF_8,
+                        java.nio.file.StandardOpenOption.CREATE,
+                        java.nio.file.StandardOpenOption.APPEND
+                    ),
+                    true
+                );
+                w.println("# Nebula replay record started at " + System.currentTimeMillis());
+            } catch (java.io.IOException e) {
+                System.err.println("[Nebula] Failed to open replay log: " + e.getMessage());
+            }
+        }
+        WRITER = w;
+    }
+
+    private NebulaReplayIntegration() {}
+
+    public static boolean enabled() { return ENABLED; }
+
+    public static long recordedTicks() { return RECORDED_TICKS.get(); }
+
+    /**
+     * Capture the structural state hash for the given level at the given
+     * tick number. Idempotent and thread-safe (PrintWriter handles its own
+     * synchronisation). No-op if recording is disabled.
+     */
+    public static void recordTick(final ServerLevel level, final long tickNumber) {
+        if (!ENABLED || WRITER == null) {
+            return;
+        }
+        try {
+            org.nebula.core.scheduler.TickPipeline pipeline = new org.nebula.core.scheduler.TickPipeline(
+                completed -> java.util.List.of(),
+                org.nebula.core.scheduler.TaskRunner.DIRECT
+            );
+            NebulaServerReplayScheduler scheduler = new NebulaServerReplayScheduler(level, pipeline);
+            byte[] digest = scheduler.computeStateHash(true);
+            StringBuilder hex = new StringBuilder(digest.length * 2);
+            for (byte b : digest) {
+                hex.append(String.format("%02x", b & 0xFF));
+            }
+            String line = tickNumber + "," + level.dimension().identifier() + "," + hex;
+            synchronized (WRITER) {
+                WRITER.println(line);
+            }
+            RECORDED_TICKS.incrementAndGet();
+        } catch (Throwable t) {
+            // Never let recording break the tick.
+            System.err.println("[Nebula] Replay record tick failed: " + t.getMessage());
+        }
+    }
+
+    public static String summary() {
+        if (!ENABLED) {
+            return "Nebula replay record: disabled (set nebula.debug.replay-record=true to enable)";
+        }
+        return "Nebula replay record: enabled, ticks=" + RECORDED_TICKS.get() + ", log=logs/nebula-replay.log";
+    }
+}
