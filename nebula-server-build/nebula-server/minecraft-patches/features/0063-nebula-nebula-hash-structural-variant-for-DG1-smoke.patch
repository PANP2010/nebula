+    /**
+     * §12.1 / DG1 — /nebula hash [structural] emits a hex digest of the current
+     * overworld state via {@link io.papermc.paper.threadedregions.NebulaServerReplayScheduler#computeStateHash(boolean)}.
+     *
+     * <p>Used by the determinism smoke harness: two consecutive runs of N
+     * empty ticks should produce identical digests. The {@code structural}
+     * variant excludes time-varying globals (gameTime, dayClock, weather)
+     * so cross-restart comparisons aren't masked by wall-clock drift.
+     */
+    private static int hash(final CommandSourceStack source, final boolean structural) {
+        final ServerLevel level = source.getLevel();
+        // Use a no-op pipeline — computeStateHash() does not invoke pipeline.execute().
+        org.nebula.core.scheduler.TickPipeline pipeline = new org.nebula.core.scheduler.TickPipeline(
+            completed -> java.util.List.of(),
+            org.nebula.core.scheduler.TaskRunner.DIRECT
+        );
+        io.papermc.paper.threadedregions.NebulaServerReplayScheduler scheduler =
+            new io.papermc.paper.threadedregions.NebulaServerReplayScheduler(level, pipeline);
+        byte[] digest = scheduler.computeStateHash(structural);
+        StringBuilder hex = new StringBuilder(digest.length * 2);
+        for (byte b : digest) {
+            hex.append(String.format("%02x", b & 0xFF));
+        }
+        final String mode = structural ? "structural" : "full";
+        final String body = "Nebula state-hash[" + level.dimension().identifier() + "][" + mode + "] tick=" + level.getGameTime() + " sha=" + hex;
+        source.sendSuccess(() -> Component.literal(body), false);
+        return digest.length;
+    }
+
     private static int reset(final CommandSourceStack source) {
         NebulaTickMetrics.reset();
         NebulaRandomGate.reset();
