From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PANP2010 <18610364979@163.com>
Date: Tue, 26 May 2026 00:16:07 +0800
Subject: [PATCH] nebula: add /nebula command for DAG scheduler introspection

Subcommands:
  - stats: aggregated tick/task/layer/parallelism counters
  - mode: NEBULA mode active flag
  - redstone: registered redstone component count
  - explosions: pending explosion-snapshot queue size
  - reset: clear accumulated DAG metrics

Adds NebulaTickMetrics.reset() for the reset subcommand.
Registers via Commands.java alongside other vanilla commands.

diff --git a/io/papermc/paper/threadedregions/NebulaTickMetrics.java b/io/papermc/paper/threadedregions/NebulaTickMetrics.java
index 79e471ae2d2cbd9cfc34b3ab1b24ea35930ce66f..e70080c03e9a67541b78c708b2eae7f3fdbe28fa 100644
--- a/io/papermc/paper/threadedregions/NebulaTickMetrics.java
+++ b/io/papermc/paper/threadedregions/NebulaTickMetrics.java
@@ -49,6 +49,17 @@ public final class NebulaTickMetrics {
         } while (!target.compareAndSet(prev, candidate));
     }
 
+    public static void reset() {
+        TOTAL_TICKS.reset();
+        TOTAL_TASKS.reset();
+        TOTAL_LAYERS.reset();
+        TOTAL_MICROSTEPS.reset();
+        TOTAL_NS.reset();
+        PEAK_TASKS_PER_TICK.set(0);
+        PEAK_LAYERS_PER_TICK.set(0);
+        PEAK_NS_PER_TICK.set(0);
+    }
+
     public static long totalTicks() { return TOTAL_TICKS.sum(); }
     public static long totalTasks() { return TOTAL_TASKS.sum(); }
     public static long totalLayers() { return TOTAL_LAYERS.sum(); }
diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index 1e1cb2aaec7037d16f3e91092e013c06bb1a7065..c2d498230bc1303c17e4e56997333cc7fdfdaf2d 100644
