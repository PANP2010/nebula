diff --git a/net/minecraft/server/commands/NebulaCommand.java b/net/minecraft/server/commands/NebulaCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..e426048ced015ce8483eed986692c4a30dabd2f5
--- /dev/null
+++ b/net/minecraft/server/commands/NebulaCommand.java
@@ -0,0 +1,81 @@
+package net.minecraft.server.commands;
+
+import com.mojang.brigadier.CommandDispatcher;
+import io.papermc.paper.threadedregions.NebulaExplosionPipeline;
+import io.papermc.paper.threadedregions.NebulaRedstoneIntegration;
+import io.papermc.paper.threadedregions.NebulaTickMetrics;
+import io.papermc.paper.threadedregions.TickRegions;
+import net.minecraft.commands.CommandSourceStack;
+import net.minecraft.commands.Commands;
+import net.minecraft.network.chat.Component;
+
+/**
+ * /nebula command — runtime introspection of the Nebula DAG scheduler.
+ *
+ * Subcommands:
+ *  - stats: aggregated tick/task/layer/parallelism counters
+ *  - mode:  whether NEBULA mode is active
+ *  - redstone: registered redstone component count
+ *  - explosions: pending explosion-snapshot queue size
+ *  - reset: clear accumulated stats
+ */
+public final class NebulaCommand {
+
+    private NebulaCommand() {}
+
+    public static void register(final CommandDispatcher<CommandSourceStack> dispatcher) {
+        dispatcher.register(
+            Commands.literal("nebula")
+                .requires(Commands.hasPermission(Commands.LEVEL_ADMINS))
+                .then(Commands.literal("stats").executes(c -> stats(c.getSource())))
+                .then(Commands.literal("mode").executes(c -> mode(c.getSource())))
+                .then(Commands.literal("redstone").executes(c -> redstone(c.getSource())))
+                .then(Commands.literal("explosions").executes(c -> explosions(c.getSource())))
+                .then(Commands.literal("reset").executes(c -> reset(c.getSource())))
+                .executes(c -> stats(c.getSource()))
+        );
+    }
+
+    private static int stats(final CommandSourceStack source) {
+        if (!TickRegions.isNebulaMode()) {
+            source.sendSuccess(() -> Component.literal("Nebula mode is disabled (running vanilla/Folia tick path)."), false);
+            return 0;
+        }
+        String summary = NebulaTickMetrics.summary();
+        source.sendSuccess(() -> Component.literal(summary), false);
+        return (int) Math.min(Integer.MAX_VALUE, NebulaTickMetrics.totalTicks());
+    }
+
+    private static int mode(final CommandSourceStack source) {
+        boolean active = TickRegions.isNebulaMode();
+        source.sendSuccess(
+            () -> Component.literal("Nebula mode: " + (active ? "ENABLED" : "DISABLED")),
+            false
+        );
+        return active ? 1 : 0;
+    }
+
+    private static int redstone(final CommandSourceStack source) {
+        int count = NebulaRedstoneIntegration.componentCount();
+        source.sendSuccess(
+            () -> Component.literal("Redstone components tracked: " + count),
+            false
+        );
+        return count;
+    }
+
+    private static int explosions(final CommandSourceStack source) {
+        int pending = NebulaExplosionPipeline.pendingCount();
+        source.sendSuccess(
+            () -> Component.literal("Explosion snapshots pending: " + pending),
+            false
+        );
+        return pending;
+    }
+
+    private static int reset(final CommandSourceStack source) {
+        NebulaTickMetrics.reset();
+        source.sendSuccess(() -> Component.literal("Nebula DAG metrics reset."), true);
+        return 1;
+    }
+}
