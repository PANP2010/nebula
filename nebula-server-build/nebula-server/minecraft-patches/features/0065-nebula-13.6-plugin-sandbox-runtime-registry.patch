+    /**
+     * §13.6 — /nebula plugins emits the runtime sandbox/level-0 split as
+     * recorded by {@link io.papermc.paper.threadedregions.NebulaPluginRegistry}.
+     */
+    private static int plugins(final CommandSourceStack source) {
+        String summary = io.papermc.paper.threadedregions.NebulaPluginRegistry.summary();
+        source.sendSuccess(() -> Component.literal(summary), false);
+        return io.papermc.paper.threadedregions.NebulaPluginRegistry.sandboxCount()
+            + io.papermc.paper.threadedregions.NebulaPluginRegistry.level0Count();
+    }
+
     private static int reset(final CommandSourceStack source) {
         NebulaTickMetrics.reset();
         NebulaRandomGate.reset();
