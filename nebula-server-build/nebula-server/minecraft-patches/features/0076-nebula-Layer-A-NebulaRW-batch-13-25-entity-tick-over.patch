+    @org.nebula.annotations.NebulaRW(
+        readEntities       = {"this.*"},
+        writeEntities      = {"this.*"},
+        readBlocks         = {"this.boundingBox.expand"},
+        triggeredEvents    = {"ENTITY_MOVED", "SOUND"},
