@@ -155,6 +155,16 @@ public final class RegionizedData<T> {
         return region.getData().getOrCreateRegionizedData(this);
     }
 
+    // Nebula start - resolve regionised data for an explicit region, usable off the owning tick thread
+    // (e.g. command-triggered async chunk-load callbacks running on the global coordinator thread).
+    public @Nullable T getForRegion(final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region) {
+        if (region == null) {
+            return null;
+        }
+        return region.getData().getOrCreateRegionizedData(this);
+    }
+    // Nebula end
+
     /**
      * Class responsible for handling merge / split requests from the regioniser.
      * <p>
diff --git a/io/papermc/paper/threadedregions/TickRegionScheduler.java b/io/papermc/paper/threadedregions/TickRegionScheduler.java
index e6764a0c5b5e0188bd37deb0b8cdebb6bac798ae..a41f30a0745753f5e6be0c9a9cbf03c7bda50544 100644
--- a/io/papermc/paper/threadedregions/TickRegionScheduler.java
+++ b/io/papermc/paper/threadedregions/TickRegionScheduler.java
@@ -175,6 +175,35 @@ public final class TickRegionScheduler {
         tickThreadRunner.currentTickingTask = task;
     }
 
+    // Nebula start - install/restore world-data context for off-region callbacks (e.g. command-triggered
+    // async chunk-load callbacks that run on the global coordinator thread). Returns the previous worldData
+    // so the caller can restore it in a finally block. No-op (returns null) off a tick thread.
+    // Resolves the region owning the given chunk so getCurrentWorldData() works during the callback.
+    public static RegionizedWorldData nebula$pushWorldDataContext(final ServerLevel level, final int chunkX, final int chunkZ) {
+        final Thread currThread = Thread.currentThread();
+        if (!(currThread instanceof TickThreadRunner tickThreadRunner)) {
+            return null;
+        }
+        final RegionizedWorldData previous = tickThreadRunner.currentTickingWorldRegionizedData;
+        if (level != null) {
+            final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
+                level.regioniser.getRegionAtSynchronised(chunkX, chunkZ);
+            if (region != null) {
+                tickThreadRunner.currentTickingWorldRegionizedData = level.worldRegionData.getForRegion(region);
+            }
+        }
+        return previous;
+    }
+
+    public static void nebula$restoreWorldDataContext(final RegionizedWorldData previous) {
+        final Thread currThread = Thread.currentThread();
+        if (!(currThread instanceof TickThreadRunner tickThreadRunner)) {
+            return;
+        }
+        tickThreadRunner.currentTickingWorldRegionizedData = previous;
+    }
+    // Nebula end
+
     /**
      * Returns the current ticking region, or {@code null} if there is no ticking region.
      * If this thread is not a TickThread, then returns {@code null}.
