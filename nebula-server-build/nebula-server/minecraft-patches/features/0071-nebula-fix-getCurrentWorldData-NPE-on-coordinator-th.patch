-                        onLoad.accept(java.util.Collections.unmodifiableList(ret));
+                        // Nebula start - install world-data context so command-triggered callbacks running on the
+                        // coordinator thread can access getCurrentWorldData() (otherwise NPEs deep in setBlock).
+                        final int ctxChunkX = ret.isEmpty() ? minChunkX : ret.get(0).getPos().x();
+                        final int ctxChunkZ = ret.isEmpty() ? minChunkZ : ret.get(0).getPos().z();
+                        final io.papermc.paper.threadedregions.RegionizedWorldData nebulaPrev =
+                            io.papermc.paper.threadedregions.TickRegionScheduler.nebula$pushWorldDataContext((ServerLevel) (Object) this, ctxChunkX, ctxChunkZ);
+                        try {
+                            onLoad.accept(java.util.Collections.unmodifiableList(ret));
+                        } finally {
+                            io.papermc.paper.threadedregions.TickRegionScheduler.nebula$restoreWorldDataContext(nebulaPrev);
+                        }
+                        // Nebula end
                     }
                 } finally {
                     for (int i = 0, len = ret.size(); i < len; ++i) {
