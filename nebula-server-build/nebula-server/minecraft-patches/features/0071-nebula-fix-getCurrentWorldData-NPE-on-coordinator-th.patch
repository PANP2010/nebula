+    // Nebula start - resolve world data by position when off the owning tick thread.
+    // Command-triggered async chunk-load callbacks run on the global coordinator thread,
+    // where getCurrentWorldData() returns null. For operations that MUST find a region
+    // (e.g. registering a block-entity ticker), fall back to the region owning the chunk.
+    public io.papermc.paper.threadedregions.RegionizedWorldData getWorldDataForPos(final BlockPos pos) {
+        final io.papermc.paper.threadedregions.RegionizedWorldData fast = this.getCurrentWorldData();
+        if (fast != null) {
+            return fast;
+        }
+        if (!(this instanceof net.minecraft.server.level.ServerLevel serverLevel)) {
+            return null;
+        }
+        final var region = serverLevel.regioniser.getRegionAtSynchronised(pos.getX() >> 4, pos.getZ() >> 4);
+        return this.worldRegionData.getForRegion(region);
+    }
+    // Nebula end
