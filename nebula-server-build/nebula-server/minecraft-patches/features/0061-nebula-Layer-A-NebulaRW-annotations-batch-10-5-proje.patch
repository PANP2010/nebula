Common projectile tick paths in survival servers:
- Projectile.tick (base class — owner read, position+velocity write)
- FishingHook.tick (random seed sync, may spawn loot items)
- FireworkRocketEntity.tick (may explode → CONTRACTIBLE)
- ThrownTrident.tick (may damage owner via channelling)
- EyeOfEnder.tick (homing toward stronghold, no entity damage)

Total annotations: 84 (65% of DG2 target).

diff --git a/net/minecraft/world/entity/projectile/EyeOfEnder.java b/net/minecraft/world/entity/projectile/EyeOfEnder.java
index 1eabbba7138340e70f832f1c89be88bbe891bae8..08f388e2e4b7d4c8ae77e29f79328889931a6c65 100644
--- a/net/minecraft/world/entity/projectile/EyeOfEnder.java
+++ b/net/minecraft/world/entity/projectile/EyeOfEnder.java
@@ -92,6 +92,17 @@ public class EyeOfEnder extends Entity implements ItemSupplier {
         } // Paper - Change EyeOfEnder target without changing other things
     }
 
+    @org.nebula.annotations.NebulaRW(
+        readEntities       = {"this.*"},
+        writeEntities      = {"this.*"},
+        readBlocks         = {"this.position"},
+        triggeredEvents    = {"ENTITY_MOVED", "ITEM_SPAWN"},
+        microStep          = org.nebula.annotations.MicroStepBehavior.NONE,
+        scc                = org.nebula.annotations.SccBehavior.AUTO,
+        maxRandomCalls     = 1,
+        randomInstance     = "ENTITY_RANDOM",
+        verifiedAt         = "1.21.4"
+    )
     @Override
     public void tick() {
         super.tick();
