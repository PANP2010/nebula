+                    // D3: When deferred impulse buffer is active, enqueue both
+                    // impulses instead of applying immediately. This keeps each
+                    // entity tick self-contained for parallel execution.
+                    if (this.level instanceof net.minecraft.server.level.ServerLevel serverLevel) {
+                        io.papermc.paper.threadedregions.RegionizedWorldData worldData =
