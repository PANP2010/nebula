@@ -53,9 +53,13 @@ public final class EntityTaskBuilder {
             worldData.forEachTickingEntity(snapshot::add);
         }
 
-        List<TaskNode> tasks = new ArrayList<>(snapshot.size() + 1);
+        DeferredImpulseBuffer buf = worldData.getDeferredImpulseBuffer();
 
+        List<TaskNode> tasks = new ArrayList<>(snapshot.size() + 2);
+
+        // Phase 0: entity activation + enable deferred impulse buffer
         tasks.add(new TaskNode("entity_activation", "ENTITY_ACTIVATION", GLOBAL_RW, () -> {
+            buf.activate();
             io.papermc.paper.entity.activation.ActivationRange.activateEntities(level);
         }));
 
@@ -64,6 +68,13 @@ public final class EntityTaskBuilder {
             tasks.add(buildSingle(entity, level, i));
         }
 
+        // Phase D3: flush deferred collision impulses after all entity tasks.
+        // GLOBAL_RW ensures this runs after every entity's self-only write.
+        tasks.add(new TaskNode("collision_flush", "COLLISION_FLUSH", GLOBAL_RW, () -> {
+            buf.flush();
+            buf.deactivate();
+        }));
+
         return tasks;
     }
 
