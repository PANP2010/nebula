Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Implements the deferred-impulse collision pipeline (architecture §6.2):

- DeferredImpulseBuffer: stores pending cross-entity impulses during
  entity tick phase, applies them in entityId-sorted order after all
  entity tasks complete
- Entity.push(Entity): when buffer is active, enqueues impulses instead
  of applying immediately — makes each entity tick self-contained
- RegionizedWorldData: region-local buffer instance
- EntityTaskBuilder: entity_activation activates buffer; collision_flush
  task (GLOBAL_RW) runs after all entity tasks to flush + deactivate
- Non-player entities re-enabled as parallelSafe (push() is deferred)

The collision_flush task's GLOBAL_RW ensures all entity self-only writes
complete before impulses are applied. This serializes the impulse-apply
phase while keeping entity ticks parallel.

diff --git a/io/papermc/paper/threadedregions/DeferredImpulseBuffer.java b/io/papermc/paper/threadedregions/DeferredImpulseBuffer.java
new file mode 100644
index 0000000000000000000000000000000000000000..254555a00dbf6915fd197cd31202ee26568aa781
--- /dev/null
+++ b/io/papermc/paper/threadedregions/DeferredImpulseBuffer.java
@@ -0,0 +1,74 @@
+package io.papermc.paper.threadedregions;
+
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.phys.Vec3;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * D3: Deferred entity-entity collision impulse buffer.
+ *
+ * <p>During the entity tick phase, {@code Entity.push(Entity)} enqueues
+ * impulses here instead of applying them immediately. This makes each
+ * entity tick self-contained (only writes to self), enabling intra-layer
+ * parallel execution.
+ *
+ * <p>After all entity tasks complete, {@link #flush()} applies the buffered
+ * impulses to each entity's deltaMovement in entityId-sorted order for
+ * determinism.
+ *
+ * <p>The buffer is region-local (one per RegionizedWorldData) and is
+ * activated/deactivated around the entity tick phase.
+ */
+public final class DeferredImpulseBuffer {
+
+    private final List<PendingImpulse> pending = new ArrayList<>();
+    private boolean active;
+
+    public void activate() {
+        this.active = true;
+        this.pending.clear();
+    }
+
+    public void deactivate() {
+        this.active = false;
+        this.pending.clear();
+    }
+
+    public boolean isActive() {
+        return this.active;
+    }
+
+    /**
+     * Enqueue an impulse to be applied later. Called from Entity.push(Entity).
+     */
+    public void enqueue(Entity target, Vec3 impulse) {
+        if (!this.active || impulse.lengthSqr() < 1.0E-14) return;
+        this.pending.add(new PendingImpulse(target.getId(), target, impulse));
+    }
+
+    /**
+     * Apply all buffered impulses. Must be called after all entity tasks
+     * complete. Impulses are sorted by entityId for determinism.
+     */
+    public void flush() {
+        if (this.pending.isEmpty()) return;
+
+        // Sort by entityId for deterministic application order
+        this.pending.sort((a, b) -> Long.compare(a.targetId, b.targetId));
+
+        for (PendingImpulse imp : this.pending) {
+            if (!imp.entity.isRemoved()) {
+                imp.entity.push(imp.impulse);
+            }
+        }
+        this.pending.clear();
+    }
+
+    public int pendingCount() {
+        return this.pending.size();
+    }
+
+    private record PendingImpulse(long targetId, Entity entity, Vec3 impulse) {}
+}
