--- a/net/minecraft/server/commands/NebulaCommand.java
+++ b/net/minecraft/server/commands/NebulaCommand.java
@@ -4,6 +4,7 @@ import com.mojang.brigadier.CommandDispatcher;
 import com.mojang.brigadier.arguments.IntegerArgumentType;
 import io.papermc.paper.threadedregions.NebulaExplosionPipeline;
 import io.papermc.paper.threadedregions.NebulaGuardIntegration;
+import io.papermc.paper.threadedregions.NebulaFidelityIntegration;
 import io.papermc.paper.threadedregions.NebulaParallelIntegration;
 import io.papermc.paper.threadedregions.NebulaRandomGate;
 import io.papermc.paper.threadedregions.NebulaRedstoneIntegration;
@@ -47,6 +48,10 @@ public final class NebulaCommand {
                 .then(Commands.literal("random").executes(c -> random(c.getSource())))
                 .then(Commands.literal("guard").executes(c -> guard(c.getSource())))
                 .then(Commands.literal("parallel").executes(c -> parallel(c.getSource())))
+                .then(Commands.literal("fidelity")
+                    .executes(c -> fidelityStatus(c.getSource()))
+                    .then(Commands.literal("reset")
+                        .executes(c -> fidelityReset(c.getSource()))))
                 .then(Commands.literal("reset").executes(c -> reset(c.getSource())))
                 .then(Commands.literal("stress-spawn")
                     .then(Commands.argument("count", IntegerArgumentType.integer(1, 5000))
@@ -118,6 +123,26 @@ public final class NebulaCommand {
         return NebulaParallelIntegration.enabled() ? 1 : 0;
     }
 
+    private static int fidelityStatus(final CommandSourceStack source) {
+        String summary = NebulaFidelityIntegration.summary();
+        source.sendSuccess(() -> Component.literal(summary), false);
+        return switch (NebulaFidelityIntegration.currentTier()) {
+            case T0 -> 0;
+            case T1 -> 1;
+            case T2 -> 2;
+            case FALLBACK -> 99;
+        };
+    }
+
+    private static int fidelityReset(final CommandSourceStack source) {
+        NebulaFidelityIntegration.reset(org.nebula.core.random.FidelityTier.T0);
+        source.sendSuccess(
+            () -> Component.literal("Nebula fidelity tier reset to T0."),
+            true
+        );
+        return 0;
+    }
+
     private static int reset(final CommandSourceStack source) {
         NebulaTickMetrics.reset();
         NebulaRandomGate.reset();
