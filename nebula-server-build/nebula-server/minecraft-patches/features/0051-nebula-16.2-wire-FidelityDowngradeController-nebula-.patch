NebulaFidelityIntegration: process-wide singleton wrapping
FidelityDowngradeController. ServerLevel.nebula$tickViaDAG calls
reportTick(overBudgetRate, msptMs) after each pipeline.execute, and
forceFallback() on DagExecutionException.

Adds /nebula fidelity:
  - bare command shows tier + counters
  - "/nebula fidelity reset" restores T0 (matches §16.2 admin contract)

Smoke verified:
  Nebula fidelity: tier=T0, ticks-reported=295, tier-downgrades=0,
  consecutive-random-over-budget=0, consecutive-mspt-exceeded=0

Note: §16.2 thresholds (10 ticks of >5% over-budget for T0→T1; 600 ticks
of >50ms MSPT for T1→T2) only fire once the placeholder actualCalls
counting in NebulaRandomGate is replaced with real per-call tracking
(B5 in NEBULA_BLOCKERS.md). The plumbing is now in place.

diff --git a/io/papermc/paper/threadedregions/NebulaFidelityIntegration.java b/io/papermc/paper/threadedregions/NebulaFidelityIntegration.java
new file mode 100644
index 0000000000000000000000000000000000000000..493996f9a8af4b32836e6b622b3c4b425658ab96
--- /dev/null
+++ b/io/papermc/paper/threadedregions/NebulaFidelityIntegration.java
@@ -0,0 +1,109 @@
+package io.papermc.paper.threadedregions;
+
+import org.nebula.core.random.FidelityTier;
+import org.nebula.core.scheduler.FidelityDowngradeController;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Architecture §11.5 + §16.2: graceful fidelity downgrade integration.
+ *
+ * <p>One process-wide {@link FidelityDowngradeController} tracks the global
+ * tier. After every DAG tick the coordinator calls {@link #reportTick} with
+ * the tick's MSPT and Random over-budget rate. The controller decides
+ * whether to drop a tier:
+ *
+ * <ul>
+ *   <li>T0 → T1: 10 consecutive ticks with Random over-budget rate &gt; 5%</li>
+ *   <li>T1 → T2: 600 consecutive ticks (~30s) with MSPT &gt; 50ms</li>
+ *   <li>T2 → FALLBACK: forced by {@link #forceFallback()} on unrecoverable DAG error</li>
+ * </ul>
+ *
+ * <p>Downgrades are sticky — admin must call {@link #reset(FidelityTier)} to
+ * restore. This is mirrored from §16.2 ("/nebula fidelity reset").
+ *
+ * <p>The controller is read-only from outside; mutating callers (the tick
+ * coordinator) go through the static methods so concurrent ticks across
+ * regions all observe the same global state.
+ */
+public final class NebulaFidelityIntegration {
+
+    private static final FidelityDowngradeController CONTROLLER = new FidelityDowngradeController();
+
+    // Light-weight counters for /nebula fidelity introspection.
+    private static final AtomicLong TICKS_REPORTED = new AtomicLong();
+    private static final AtomicLong TIER_DOWNGRADES = new AtomicLong();
+    private static volatile FidelityTier lastObservedTier = FidelityTier.T0;
+
+    private NebulaFidelityIntegration() {}
+
+    /**
+     * Report a completed DAG tick. The controller may downgrade the tier
+     * after this call. Returns the (possibly new) current tier.
+     */
+    public static FidelityTier reportTick(double randomOverBudgetRate, long msptMs) {
+        TICKS_REPORTED.incrementAndGet();
+        synchronized (CONTROLLER) {
+            FidelityTier prior = CONTROLLER.currentTier();
+            FidelityTier now = CONTROLLER.reportTick(randomOverBudgetRate, msptMs);
+            if (now != prior) {
+                TIER_DOWNGRADES.incrementAndGet();
+            }
+            lastObservedTier = now;
+            return now;
+        }
+    }
+
+    /** Drop straight to FALLBACK — used when a tick throws unrecoverably. */
+    public static void forceFallback() {
+        synchronized (CONTROLLER) {
+            FidelityTier prior = CONTROLLER.currentTier();
+            CONTROLLER.forceFallback();
+            if (CONTROLLER.currentTier() != prior) {
+                TIER_DOWNGRADES.incrementAndGet();
+            }
+            lastObservedTier = FidelityTier.FALLBACK;
+        }
+    }
+
+    /** Admin reset (e.g. /nebula fidelity reset). */
+    public static void reset(FidelityTier tier) {
+        synchronized (CONTROLLER) {
+            CONTROLLER.reset(tier);
+            lastObservedTier = tier;
+        }
+    }
+
+    public static FidelityTier currentTier() {
+        return lastObservedTier;
+    }
+
+    public static int consecutiveRandomOverBudgetCount() {
+        synchronized (CONTROLLER) {
+            return CONTROLLER.consecutiveRandomOverBudgetCount();
+        }
+    }
+
+    public static int consecutiveMsptExceededCount() {
+        synchronized (CONTROLLER) {
+            return CONTROLLER.consecutiveMsptExceededCount();
+        }
+    }
+
+    public static long ticksReported() {
+        return TICKS_REPORTED.get();
+    }
+
+    public static long tierDowngrades() {
+        return TIER_DOWNGRADES.get();
+    }
+
+    public static String summary() {
+        return String.format(
+            "Nebula fidelity: tier=%s, ticks-reported=%d, tier-downgrades=%d, "
+                + "consecutive-random-over-budget=%d, consecutive-mspt-exceeded=%d",
+            currentTier(), ticksReported(), tierDowngrades(),
+            consecutiveRandomOverBudgetCount(), consecutiveMsptExceededCount()
+        );
+    }
+}
