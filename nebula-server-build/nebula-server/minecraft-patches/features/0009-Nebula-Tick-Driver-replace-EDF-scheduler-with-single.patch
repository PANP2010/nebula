@@ -0,0 +1,139 @@
+package io.papermc.paper.threadedregions;
+
+import com.mojang.logging.LogUtils;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import org.slf4j.Logger;
+import java.util.concurrent.locks.LockSupport;
+
+public final class NebulaTickDriver {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final long TICK_INTERVAL_NS = TickRegionScheduler.TIME_BETWEEN_TICKS;
+
+    private static NebulaTickDriver INSTANCE;
+
+    private final NebulaCoordinatorThread coordinator;
+    private volatile boolean running;
+    private long tickCount;
+
+    public NebulaTickDriver() {
+        INSTANCE = this;
+        this.coordinator = new NebulaCoordinatorThread();
+    }
+
+    public void start() {
+        this.running = true;
+        this.coordinator.start();
+    }
+
+    public static boolean halt(final boolean sync, final long maxWaitNS) {
+        if (INSTANCE == null) {
+            return true;
+        }
+        INSTANCE.running = false;
+        LockSupport.unpark(INSTANCE.coordinator);
+        if (!sync) {
+            return !INSTANCE.coordinator.isAlive();
+        }
+        try {
+            INSTANCE.coordinator.join(maxWaitNS == 0L ? 0L : Math.max(1L, maxWaitNS / 1_000_000L));
+        } catch (final InterruptedException ignored) {}
+        return !INSTANCE.coordinator.isAlive();
+    }
+
+    public static Thread getCoordinatorThread() {
+        return INSTANCE == null ? null : INSTANCE.coordinator;
+    }
+
+    private final class NebulaCoordinatorThread extends TickRegionScheduler.TickThreadRunner {
+
+        NebulaCoordinatorThread() {
+            super(null, null, "Nebula Tick Coordinator");
+            this.setDaemon(false);
+        }
+
+        @Override
+        public void run() {
+            LOGGER.info("Nebula Tick Coordinator started");
+            while (NebulaTickDriver.this.running) {
+                final long tickStart = System.nanoTime();
+                try {
+                    tickCycle(tickStart);
+                } catch (final Throwable t) {
+                    LOGGER.error("Exception in Nebula tick cycle", t);
+                    NebulaTickDriver.this.running = false;
+                    MinecraftServer.getServer().stopServer();
+                    return;
+                }
+                final long elapsed = System.nanoTime() - tickStart;
+                final long sleepNs = TICK_INTERVAL_NS - elapsed;
+                if (sleepNs > 0) {
+                    LockSupport.parkNanos(sleepNs);
+                }
+            }
+            LOGGER.info("Nebula Tick Coordinator stopped");
+        }
+    }
+
+    private void tickCycle(final long tickStart) {
+        final long scheduledEnd = tickStart + TICK_INTERVAL_NS;
+        ++this.tickCount;
+
+        // Phase 1: Global tick
+        tickGlobal(scheduledEnd);
+
+        // Phase 2: Region ticks (sequential in Phase B)
+        tickAllRegions(tickStart, scheduledEnd);
+    }
+
+    private void tickGlobal(final long scheduledEnd) {
+        final RegionizedServer server = RegionizedServer.getInstance();
+        final TickRegionScheduler.RegionScheduleHandle globalHandle = RegionizedServer.getGlobalTickData();
+
+        TickRegionScheduler.setTickTask(globalHandle);
+        try {
+            // drain global task queue and packets (mirrors GlobalTickTickHandle.drainTasks)
+            Runnable task;
+            while ((task = server.globalTickQueue.poll()) != null) {
+                task.run();
+            }
+            while (server.packetProcessor.executeSinglePacket());
+
+            server.globalTick(this.tickCount);
+        } finally {
+            TickRegionScheduler.setTickTask(null);
+        }
+    }
+
+    private void tickAllRegions(final long startTime, final long scheduledEnd) {
+        for (final ServerLevel level : MinecraftServer.getServer().getAllLevels()) {
+            level.regioniser.computeForAllRegions(region -> {
+                tickSingleRegion(region, startTime, scheduledEnd);
+            });
+        }
+    }
+
+    private void tickSingleRegion(
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region,
+        final long startTime,
+        final long scheduledEnd
+    ) {
+        if (!region.tryMarkTicking(() -> false)) {
+            return; // region is in transient state (merging/splitting), skip
+        }
+
+        final TickRegions.TickRegionData data = region.getData();
+        data.getRegionSchedulingHandle().incrementTickCount();
+
+        TickRegionScheduler.setTickingRegion(region);
+        TickRegionScheduler.setTickTask(data.getRegionSchedulingHandle());
+        try {
+            MinecraftServer.getServer().tickServer(startTime, scheduledEnd, 10_000_000L, data);
+        } finally {
+            TickRegionScheduler.setTickTask(null);
+            TickRegionScheduler.setTickingRegion(null);
+            region.markNotTicking();
+        }
+    }
+}
