--- a/net/minecraft/world/entity/ambient/Bat.java
+++ b/net/minecraft/world/entity/ambient/Bat.java
@@ -113,6 +113,17 @@ public class Bat extends AmbientCreature {
         }
     }
 
+    @org.nebula.annotations.NebulaRW(
+        readEntities       = {"this.*"},
+        writeEntities      = {"this.deltaMovement", "this.position"},
+        readBlocks         = {"this.boundingBox.expand"},
+        triggeredEvents    = {"ENTITY_MOVED"},
+        microStep          = org.nebula.annotations.MicroStepBehavior.NONE,
+        scc                = org.nebula.annotations.SccBehavior.AUTO,
+        maxRandomCalls     = 4,
+        randomInstance     = "ENTITY_RANDOM",
+        verifiedAt         = "1.21.4"
+    )
     @Override
     public void tick() {
         super.tick();
