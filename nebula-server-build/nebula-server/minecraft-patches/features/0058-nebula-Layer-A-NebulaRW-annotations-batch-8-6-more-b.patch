+        triggeredEvents    = {"BLOCK_UPDATE"},
+        microStep          = org.nebula.annotations.MicroStepBehavior.NONE,
+        scc                = org.nebula.annotations.SccBehavior.AUTO,
+        maxRandomCalls     = 0,
+        randomInstance     = "WORLD_RANDOM",
+        mayLoadChunks      = false,
+        mayTriggerBlockUpdates = true,
+        verifiedAt         = "1.21.4"
+    )
