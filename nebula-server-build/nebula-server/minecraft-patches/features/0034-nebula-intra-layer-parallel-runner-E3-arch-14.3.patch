+++ b/io/papermc/paper/threadedregions/TickRegionScheduler.java
@@ -318,6 +318,29 @@ public final class TickRegionScheduler {
         public TickThreadRunner(final ThreadGroup group, final Runnable run, final String name) {
             super(group, run, name);
         }
+
+        // Nebula start — package-private accessors so NebulaParallelWorker can mirror parent state
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> nebula$currentTickingRegion() {
+            return this.currentTickingRegion;
+        }
+        final void nebula$setCurrentTickingRegion(
+            final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> r
+        ) {
+            this.currentTickingRegion = r;
+        }
+        final RegionizedWorldData nebula$currentTickingWorldRegionizedData() {
+            return this.currentTickingWorldRegionizedData;
+        }
+        final void nebula$setCurrentTickingWorldRegionizedData(final RegionizedWorldData d) {
+            this.currentTickingWorldRegionizedData = d;
+        }
+        final SchedulableTick nebula$currentTickingTask() {
+            return this.currentTickingTask;
+        }
+        final void nebula$setCurrentTickingTask(final SchedulableTick t) {
+            this.currentTickingTask = t;
+        }
+        // Nebula end
     }
 
     public static abstract class RegionScheduleHandle extends SchedulableTick {
