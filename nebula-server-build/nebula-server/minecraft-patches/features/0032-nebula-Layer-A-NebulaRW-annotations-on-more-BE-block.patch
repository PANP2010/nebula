From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PANP2010 <18610364979@163.com>
Date: Tue, 26 May 2026 17:58:44 +0800
Subject: [PATCH] nebula: Layer A @NebulaRW annotations on more BE + block
 randomTick (E1c)

SpawnerBlockEntity, ConduitBlockEntity, BeehiveBlockEntity serverTick
plus LeavesBlock, CropBlock, FarmlandBlock randomTick. The three BEs
are SERIALIZED (entity spawning / mob effects / bee release have wide
side-effect surfaces); the random-tick blocks are AUTO with conservative
neighbor reads.

diff --git a/net/minecraft/world/level/block/CropBlock.java b/net/minecraft/world/level/block/CropBlock.java
index b8456dc5cb428593701d07837ba5c8ae063af876..bf3895341265da2e2fb71fcd7c6286e2bf564f2e 100644
--- a/net/minecraft/world/level/block/CropBlock.java
+++ b/net/minecraft/world/level/block/CropBlock.java
@@ -75,6 +75,22 @@ public class CropBlock extends VegetationBlock implements BonemealableBlock {
         return !this.isMaxAge(state);
     }
 
+    @org.nebula.annotations.NebulaRW(
+        readEntities       = {},
+        writeEntities      = {},
+        readBlocks         = {"{pos}", "{pos.below}", "*"},
+        readBlockEntities  = {},
+        writeBlockEntities = {},
+        readGlobals        = {"WORLD_TIME", "GAME_RULES"},
+        writeGlobals       = {},
+        triggeredEvents    = {"BLOCK_GROW"},
+        microStep          = org.nebula.annotations.MicroStepBehavior.NONE,
+        scc                = org.nebula.annotations.SccBehavior.AUTO,
+        maxRandomCalls     = 4,
+        randomInstance     = "WORLD_RANDOM",
+        mayLoadChunks      = false,
+        verifiedAt         = "1.21.4"
+    )
     @Override
     protected void randomTick(final BlockState state, final ServerLevel level, final BlockPos pos, final RandomSource random) {
         if (level.getRawBrightness(pos, 0) >= 9) {
