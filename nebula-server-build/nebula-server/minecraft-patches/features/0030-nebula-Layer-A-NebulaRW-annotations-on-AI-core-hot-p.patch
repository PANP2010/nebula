From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PANP2010 <18610364979@163.com>
Date: Tue, 26 May 2026 17:58:22 +0800
Subject: [PATCH] nebula: Layer A @NebulaRW annotations on AI core hot path
 (E1a)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Mob.serverAiStep, Brain.tick, GoalSelector.tick, PathNavigation.tick,
{Look,Move,Jump}Control.tick — declares the read/write footprint of
the AI tick chain so RW-Guard can validate it. Conservative wildcards
(`*`) are used where the closure of accesses is dynamically bounded
(sensor scans, behavior dispatch); guard violations will refine these.

diff --git a/net/minecraft/world/entity/Mob.java b/net/minecraft/world/entity/Mob.java
index 70832b53a3abf3b831312f924cca17067a2f5221..f8fb09a90a83ceca9aa04a80f0364896f170c2e9 100644
--- a/net/minecraft/world/entity/Mob.java
+++ b/net/minecraft/world/entity/Mob.java
@@ -833,6 +833,22 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
         }
     }
 
+    @org.nebula.annotations.NebulaRW(
+        readEntities       = {"this.*", "*"},
+        writeEntities      = {"this.*"},
+        readBlocks         = {"*"},
+        readBlockEntities  = {},
+        writeBlockEntities = {},
+        readGlobals        = {"WORLD_TIME"},
+        writeGlobals       = {},
+        triggeredEvents    = {"AI_GOAL_TICK", "PATH_RECOMPUTE"},
+        microStep          = org.nebula.annotations.MicroStepBehavior.NONE,
+        scc                = org.nebula.annotations.SccBehavior.AUTO,
+        maxRandomCalls     = 64,
+        randomInstance     = "ENTITY_RANDOM",
+        mayLoadChunks      = false,
+        verifiedAt         = "1.21.4"
+    )
     @Override
     protected final void serverAiStep() {
         this.noActionTime++;
