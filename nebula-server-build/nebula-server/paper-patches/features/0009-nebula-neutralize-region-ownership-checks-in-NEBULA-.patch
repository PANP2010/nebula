From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PANP2010 <18610364979@163.com>
Date: Mon, 25 May 2026 12:21:14 +0800
Subject: [PATCH] nebula: neutralize region ownership checks in NEBULA mode
 (Phase C)

- Add isNebulaMode() fast-path to 3 core isTickThreadFor methods and
  deprecated ensureTickThread(String) in TickThread.java
- Force gridExponent=31 in TickRegions.init() for NEBULA mode to
  guarantee single region per world (no merge/split)
- Remove tryMarkTicking/markNotTicking from NebulaTickDriver since
  single region never transitions

diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
index 6c74787321748702022787b65ff5465f8bcec4ad..b3366c44ff46cb4608f1740f7504ea444924b909 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
@@ -48,6 +48,7 @@ public class TickThread extends Thread {
      */
     @Deprecated
     public static void ensureTickThread(final String reason) {
+        if (io.papermc.paper.threadedregions.TickRegions.isNebulaMode()) return;
         if (!isTickThread()) {
             LOGGER.error("Thread failed main thread check: " + reason + ", context=" + getThreadContext(), new Throwable());
             throw new IllegalStateException(reason);
@@ -171,6 +172,7 @@ public class TickThread extends Thread {
     }
 
     public static boolean isTickThreadFor(final Level world, final int chunkX, final int chunkZ) {
+        if (io.papermc.paper.threadedregions.TickRegions.isNebulaMode()) return true;
         final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
             TickRegionScheduler.getCurrentRegion();
         if (region == null) {
@@ -209,6 +211,7 @@ public class TickThread extends Thread {
     }
 
     public static boolean isTickThreadFor(final Level world, final int fromChunkX, final int fromChunkZ, final int toChunkX, final int toChunkZ) {
+        if (io.papermc.paper.threadedregions.TickRegions.isNebulaMode()) return true;
         final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
             TickRegionScheduler.getCurrentRegion();
         if (region == null) {
@@ -243,6 +246,7 @@ public class TickThread extends Thread {
         if (entity == null) {
             return true;
         }
+        if (io.papermc.paper.threadedregions.TickRegions.isNebulaMode()) return true;
         final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
             TickRegionScheduler.getCurrentRegion();
         if (region == null) {
